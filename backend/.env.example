# --- App / DB ---
SECRET_KEY=change-me-in-production
# SQLite by default (zero setup). Point at Postgres in production:
# DATABASE_URL=postgresql+psycopg2://impactlens:password@localhost:5432/impactlens
DATABASE_URL=sqlite:///./impactlens.db
CORS_ORIGINS=http://localhost:3000

DEMO_MODE=true

# --- GitHub OAuth (leave blank to stay in demo login mode) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Entire CLI / Entire Graph ---
# https://github.com/entireio/entire-graph , https://github.com/entireio/cli
# https://docs.entire.io/quickstart
ENTIRE_CLI_PATH=entire
ENTIRE_REPOS_ROOT=./repos
USE_REAL_ENTIRE_CLI=false

# --- Databricks ---
# https://docs.databricks.com/aws/en/dev-tools/databricks-apps
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
USE_REAL_DATABRICKS=false

# --- AI explanation layer (template engine unless both are set) ---
ANTHROPIC_API_KEY=
USE_REAL_LLM=false

RATE_LIMIT_PER_MINUTE=60
